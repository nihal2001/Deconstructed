// Copy to Config/Secrets.xcconfig (git-ignored) and fill in. Never commit real values.
//
// GOOGLE_MAPS_API_KEY  One iOS-restricted key with Maps SDK for iOS + Places API (New) enabled.
//                      Restrict it to this app's bundle ID in Google Cloud Console.
// SUPABASE_PROJECT_HOST  Host only, no scheme, e.g. abcdefghijkl.supabase.co
//                        (xcconfig treats "//" as a comment, so the scheme is added in code).
// SUPABASE_ANON_KEY    The project's anon / publishable key. Never the service_role key.

GOOGLE_MAPS_API_KEY =
SUPABASE_PROJECT_HOST =
SUPABASE_ANON_KEY =

// Optional overrides
// APP_BUNDLE_ID = com.yourcompany.deconstructed
// DEVELOPMENT_TEAM = ABCDE12345
// PLACES_MAX_REQUESTS_PER_MINUTE = 30
// PLACES_MAX_REQUESTS_PER_DAY = 400
